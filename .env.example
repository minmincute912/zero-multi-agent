# Copy to .env (git-ignored) and fill in. Never commit real values.
# Used by: docker compose --env-file .env -f docker-services/docker-compose.yml ...

# --- inference-router (LiteLLM) ---
# Any long random string; Hermes and other clients send it as the API key to the router.
LITELLM_MASTER_KEY=
# https://openrouter.ai/keys   (free models only: ids ending in ":free")
OPENROUTER_API_KEY=
# Cloudflare dashboard > Workers AI > API token (Workers AI permission) and your account id
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
# Nous Portal key. Used by the heavy-backup group (free ":free" models), tried when OpenRouter's heavy pool fails.
NOUS_API_KEY=
# Optional: Ollama on a Google Colab T4, reached over Tailscale, e.g. http://100.x.y.z:11434. Also uncomment the
# Colab block in docker-services/inference-router/config.yaml.
COLAB_OLLAMA_BASE_URL=

# --- mcp-web-worker ---
# Password for noVNC (port 6080, localhost only). Required.
VNC_PASSWORD=
# Must own ./docker-services/browser-profiles on the host (run `id -u` and `id -g` as the deploy user)
HOST_UID=1000
HOST_GID=1000

# --- images ---
# GitHub owner (lowercase) that publishes the GHCR images. "local" means build on this machine.
GHCR_OWNER=local
IMAGE_TAG=latest

# --- Hermes native (these belong in ~/.hermes/.env on the VPS, shown here for reference) ---
# HERMES_CORE_DIR=/opt/hermes-platform/hermes-core
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USERS=123456789
